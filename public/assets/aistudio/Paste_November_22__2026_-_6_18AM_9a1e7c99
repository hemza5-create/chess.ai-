    /*************************************************************************
     * 4. محرك التقييم الذكي (Minimax + Alpha-Beta Pruning + Piece-Square Tables)
     *************************************************************************/
    const PIECE_VALUES = { p: 100, n: 320, b: 330, r: 500, q: 900, k: 20000 };

    // جداول تمركز القطع لتوجيه المحرك نحو اللعب الموضعي السليم
    const PST_PAWN = [
       0,  0,  0,  0,  0,  0,  0,  0,
      50, 50, 50, 50, 50, 50, 50, 50,
      10, 10, 20, 30, 30, 20, 10, 10,
       5,  5, 10, 25, 25, 10,  5,  5,
       0,  0,  0, 20, 20,  0,  0,  0,
       5, -5,-10,  0,  0,-10, -5,  5,
       5, 10, 10,-20,-20, 10, 10,  5,
       0,  0,  0,  0,  0,  0,  0,  0
    ];

    const PST_KNIGHT = [
      -50,-40,-30,-30,-30,-30,-40,-50,
      -40,-20,  0,  0,  0,  0,-20,-40,
      -30,  0, 10, 15, 15, 10,  0,-30,
      -30,  5, 15, 20, 20, 15,  5,-30,
      -30,  0, 15, 20, 20, 15,  0,-30,
      -30,  5, 10, 15, 15, 10,  5,-30,
      -40,-20,  0,  5,  5,  0,-20,-40,
      -50,-40,-30,-30,-30,-30,-40,-50
    ];

    const PST_BISHOP = [
      -20,-10,-10,-10,-10,-10,-10,-20,
      -10,  0,  0,  0,  0,  0,  0,-10,
      -10,  0,  5, 10, 10,  5,  0,-10,
      -10,  5,  5, 10, 10,  5,  5,-10,
      -10,  0, 10, 10, 10, 10,  0,-10,
      -10, 10, 10, 10, 10, 10, 10,-10,
      -10,  5,  0,  0,  0,  0,  5,-10,
      -20,-10,-10,-10,-10,-10,-10,-20
    ];

    let evaluatedNodes = 0;

    function evaluateBoardStatic(chessInstance) {
      if (chessInstance.in_checkmate()) {
        return chessInstance.turn() === 'w' ? -99999 : 99999;
      }
      if (chessInstance.in_draw() || chessInstance.in_stalemate() || chessInstance.in_threefold_repetition()) {
        return 0;
      }

      const board = chessInstance.board();
      let totalEval = 0;

      for (let r = 0; r < 8; r++) {
        for (let c = 0; c < 8; c++) {
          const piece = board[r][c];
          if (!piece) continue;

          const idx = piece.color === 'w' ? r * 8 + c : (7 - r) * 8 + c;
          let positional = 0;
          if (piece.type === 'p') positional = PST_PAWN[idx];
          else if (piece.type === 'n') positional = PST_KNIGHT[idx];
          else if (piece.type === 'b') positional = PST_BISHOP[idx];

          const val = PIECE_VALUES[piece.type] + positional;
          totalEval += piece.color === 'w' ? val : -val;
        }
      }
      return totalEval;
    }

    function minimax(chessInstance, depth, alpha, beta, isMaximizing) {
      evaluatedNodes++;
      if (depth === 0 || chessInstance.game_over()) {
        return evaluateBoardStatic(chessInstance);
      }

      const moves = chessInstance.moves({ verbose: true });
      // ترتيب النقلات: الأسر والترقية أولاً لتسريع تقليم ألفا-بيتا
      moves.sort((a, b) => (b.captured ? 10 : 0) - (a.captured ? 10 : 0));

      if (isMaximizing) {
        let maxEval = -Infinity;
        for (const m of moves) {
          chessInstance.move(m);
          const ev = minimax(chessInstance, depth - 1, alpha, beta, false);
          chessInstance.undo();
          if (ev > maxEval) maxEval = ev;
          if (ev > alpha) alpha = ev;
          if (beta <= alpha) break;
        }
        return maxEval;
      } else {
        let minEval = Infinity;
        for (const m of moves) {
          chessInstance.move(m);
          const ev = minimax(chessInstance, depth - 1, alpha, beta, true);
          chessInstance.undo();
          if (ev < minEval) minEval = ev;
          if (ev < beta) beta = ev;
          if (beta <= alpha) break;
        }
        return minEval;
      }
    }

    function computeMultiPV(fen, depth) {
      evaluatedNodes = 0;
      const tempGame = new Chess(fen);
      const isWhite = tempGame.turn() === 'w';
      const legalMoves = tempGame.moves({ verbose: true });

      if (legalMoves.length === 0) {
        return {
          scoreCp: evaluateBoardStatic(tempGame),
          lines: []
        };
      }

      const results = [];
      for (const move of legalMoves) {
        tempGame.move(move);
        const score = minimax(tempGame, Math.max(0, depth - 1), -Infinity, Infinity, !isWhite);

        // استخراج تكملة سريعة (PV) من 3 نقلات
        const pvMoves = [move.san];
        const rollout = new Chess(tempGame.fen());
        for (let step = 0; step < 3; step++) {
          const nextMoves = rollout.moves({ verbose: true });
          if (nextMoves.length === 0) break;
          nextMoves.sort((a, b) => (b.captured ? 5 : 0) - (a.captured ? 5 : 0));
          rollout.move(nextMoves[0]);
          pvMoves.push(nextMoves[0].san);
        }

        tempGame.undo();
        results.push({
          move,
          uci: move.from + move.to + (move.promotion || ''),
          san: move.san,
          scoreCp: score,
          pv: pvMoves.join(' ')
        });
      }

      results.sort((a, b) => isWhite ? b.scoreCp - a.scoreCp : a.scoreCp - b.scoreCp);
      return {
        scoreCp: results[0].scoreCp,
        lines: results.slice(0, 3)
      };
    }

    /*************************************************************************
     * 5. حالة اللعبة والتفاعل مع الواجهة
     *************************************************************************/
    const game = new Chess();
    let boardOrientation = 'w';
    let selectedSquare = null;
    let legalTargets = [];
    let showVisionArrows = true;
    let appMode = 'analysis'; // 'analysis' | 'ai' | 'puzzle'
    let currentBestMove = null;
    let currentPuzzle = null;
    let lastEvalBeforeMove = 25;
    let moveAccuracies = [];

    const FILES = ['a', 'b', 'c', 'd', 'e', 'f', 'g', 'h'];
    const RANKS = ['8', '7', '6', '5', '4', '3', '2', '1'];

    function showToast(message, type = 'info') {
      const container = document.getElementById('toast-container');
      const el = document.createElement('div');
      const colors = {
        info: 'bg-slate-900 border-slate-700 text-slate-100',
        success: 'bg-emerald-950/95 border-emerald-500/50 text-emerald-200',
        warn: 'bg-amber-950/95 border-[#e5da23]/60 text-[#e5da23]'
      };
      el.className = `px-4 py-2.5 rounded-xl border text-xs font-bold shadow-xl backdrop-blur-md text-center transition-all duration-300 ${colors[type] || colors.info}`;
      el.textContent = message;
      container.appendChild(el);
      setTimeout(() => {
        el.style.opacity = '0';
        setTimeout(() => el.remove(), 300);
      }, 2800);
    }

    function renderBoard() {
      const boardEl = document.getElementById('chess-board');
      boardEl.innerHTML = '';

      const history = game.history({ verbose: true });
      const lastMove = history.length > 0 ? history[history.length - 1] : null;
      const inCheck = game.in_check();
      const turnColor = game.turn();

      const displayRanks = boardOrientation === 'w' ? RANKS : [...RANKS].reverse();
      const displayFiles = boardOrientation === 'w' ? FILES : [...FILES].reverse();

      for (let rIdx = 0; rIdx < 8; rIdx++) {
        for (let fIdx = 0; fIdx < 8; fIdx++) {
          const rank = displayRanks[rIdx];
          const file = displayFiles[fIdx];
          const sq = file + rank;

          const actualFileIndex = FILES.indexOf(file);
          const actualRankIndex = RANKS.indexOf(rank);
          const isLight = (actualFileIndex + actualRankIndex) % 2 === 0;

          const piece = game.get(sq);
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.dataset.square = sq;
          btn.onclick = () => handleSquareClick(sq);

          let classes = `square-btn relative flex items-center justify-center w-full h-full focus:outline-none ${isLight ? 'sq-light' : 'sq-dark'}`;
          if (selectedSquare === sq) classes += ' sq-selected';
          if (lastMove && (lastMove.from === sq || lastMove.to === sq)) classes += ' sq-last-move';
          if (inCheck && piece && piece.type === 'k' && piece.color === turnColor) classes += ' sq-check';
          btn.className = classes;

          // إحداثيات الصف والعمود على الحواف
          if (fIdx === 0) {
            const rankLabel = document.createElement('span');
            rankLabel.className = 'absolute top-0.5 left-1 text-[10px] font-mono font-bold opacity-80 pointer-events-none';
            rankLabel.textContent = rank;
            btn.appendChild(rankLabel);
          }
          if (rIdx === 7) {
            const fileLabel = document.createElement('span');
            fileLabel.className = 'absolute bottom-0.5 right-1 text-[10px] font-mono font-bold opacity-80 pointer-events-none';
            fileLabel.textContent = file;
            btn.appendChild(fileLabel);
          }

          // رسم القطعة
          if (piece) {
            const key = piece.color + piece.type.toUpperCase();
            btn.insertAdjacentHTML('beforeend', PIECE_SVGS[key]);
          }

          // مؤشر النقلة القانونية
          if (legalTargets.includes(sq)) {
            const marker = document.createElement('div');
            marker.className = piece ? 'legal-ring absolute' : 'legal-dot absolute';
            btn.appendChild(marker);
          }

          boardEl.appendChild(btn);
        }
      }

      updateGameMetadataUI();
    }

    function handleSquareClick(sq) {
      if (game.game_over()) {
        showToast(currentLang === 'ar' ? 'انتهت المباراة! اضغط على "جديد" للبدء من جديد.' : 'Game over! Click "New" to restart.', 'warn');
        return;
      }

      // إذا تم اختيار مربع وجهة قانوني
      if (selectedSquare && legalTargets.includes(sq)) {
        const piece = game.get(selectedSquare);
        const isPromotion = piece && piece.type === 'p' &&
          ((piece.color === 'w' && sq[1] === '8') || (piece.color === 'b' && sq[1] === '1'));

        if (isPromotion) {
          openPromotionModal(selectedSquare, sq, piece.color);
          return;
        }

        executePlayerMove({ from: selectedSquare, to: sq });
        return;
      }

      // تحديد قطعة جديدة
      const clickedPiece = game.get(sq);
      if (clickedPiece && clickedPiece.color === game.turn()) {
        selectedSquare = sq;
        const moves = game.moves({ square: sq, verbose: true });
        legalTargets = moves.map(m => m.to);
      } else {
        selectedSquare = null;
        legalTargets = [];
      }
      renderBoard();
    }

    function openPromotionModal(from, to, color) {
      const modal = document.getElementById('promotion-modal');
      const container = document.getElementById('promotion-choices');
      container.innerHTML = '';

      ['q', 'r', 'b', 'n'].forEach(pType => {
        const btn = document.createElement('button');
        btn.className = 'p-2 rounded-xl bg-slate-800 hover:bg-[#cceb0d]/20 border border-slate-700 hover:border-[#cceb0d] flex items-center justify-center aspect-square transition';
        btn.innerHTML = PIECE_SVGS[color + pType.toUpperCase()];
        btn.onclick = () => {
          modal.classList.add('hidden');
          modal.classList.remove('flex');
          executePlayerMove({ from, to, promotion: pType });
        };
        container.appendChild(btn);
      });

      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function executePlayerMove(moveObj) {
      const moverColor = game.turn();
      const moveResult = game.move(moveObj);
      selectedSquare = null;
      legalTargets = [];

      if (!moveResult) {
        renderBoard();
        return;
      }

      renderBoard();
      analyzeCurrentPosition(moverColor, moveResult);

      // التحقق من حل اللغز في وضع التدريب
      if (appMode === 'puzzle' && currentPuzzle) {
        const playedUci = moveResult.from + moveResult.to + (moveResult.promotion || '');
        if (playedUci === currentPuzzle.solutionUci) {
          showToast(currentLang === 'ar' ? '🎯 ممتاز! نقلة تكتيكية حاسمة وصحيحة!' : '🎯 Brilliant! Correct tactical solution!', 'success');
        } else {
          showToast(currentLang === 'ar' ? '❌ ليست النقلة الأدق في هذا اللغز، جرب التراجع!' : '❌ Not the best tactical move, try Undo!', 'warn');
        }
        return;
      }

      // رد المحرك الآلي في وضع "تحدي المحرك"
      if (appMode === 'ai' && !game.game_over()) {
        setTimeout(() => {
          playEngineBestMove();
        }, 320);
      }
    }

    /*************************************************************************
     * 6. تحديث التحليل، أسهم Chess-Vision، وشريط التقييم
     *************************************************************************/
    function analyzeCurrentPosition(lastMoverColor = null, lastMoveObj = null) {
      const depth = parseInt(document.getElementById('depth-select').value, 10) || 2;
      const analysis = computeMultiPV(game.fen(), depth);
      const scoreCp = analysis.scoreCp;

      document.getElementById('nodes-counter').textContent = `${evaluatedNodes.toLocaleString()} nodes`;

      // تحديث شريط التقييم والنص
      updateEvalBar(scoreCp);

      // تحديث أفضل نقلة وخطوط MultiPV
      const pvContainer = document.getElementById('pv-lines-container');
      pvContainer.innerHTML = '';

      if (analysis.lines.length > 0) {
        currentBestMove = analysis.lines[0].move;
        document.getElementById('engine-best-san').textContent = analysis.lines[0].san;
        document.getElementById('engine-best-uci').textContent = `(${analysis.lines[0].uci})`;

        analysis.lines.forEach((line, idx) => {
          const row = document.createElement('div');
          row.className = 'flex items-center justify-between gap-2 px-2 py-1.5 rounded-lg bg-slate-900/90 border border-slate-800/80 hover:border-[#cceb0d]/40 cursor-pointer transition';
          row.onclick = () => {
            game.move(line.move);
            selectedSquare = null;
            legalTargets = [];
            renderBoard();
            analyzeCurrentPosition();
          };

          const scoreBadge = formatScore(line.scoreCp);
          const isPositive = line.scoreCp >= 0;
          row.innerHTML = `
            <span class="px-1.5 py-0.5 rounded text-[11px] font-bold ${isPositive ? 'bg-slate-100 text-slate-950' : 'bg-slate-800 text-slate-200'}">${scoreBadge}</span>
            <span class="flex-1 text-slate-300 truncate" dir="ltr">${idx + 1}. ${line.pv}</span>
          `;
          pvContainer.appendChild(row);
        });
      } else {
        currentBestMove = null;
        document.getElementById('engine-best-san').textContent = '-';
        document.getElementById('engine-best-uci').textContent = '';
      }

      // تقييم جودة النقلة السابقة وتقديم نصيحة المدرب
      if (lastMoverColor && lastMoveObj) {
        evaluateMoveQuality(lastMoverColor, lastMoveObj, lastEvalBeforeMove, scoreCp);
      }
      lastEvalBeforeMove = scoreCp;

      // رسم أسهم الرؤية على الرقعة
      drawVisionArrows(analysis.lines);
    }

    function evaluateMoveQuality(moverColor, moveObj, prevCp, newCp) {
      // حساب الفقدان في التقييم من منظور اللاعب الذي قام بالنقلة
      const diff = moverColor === 'w' ? (prevCp - newCp) : (newCp - prevCp);
      const badge = document.getElementById('move-quality-badge');
      const coachText = document.getElementById('coach-advice-text');

      let acc = 100;
      if (diff <= 25) {
        badge.textContent = currentLang === 'ar' ? '★ نقلة ممتازة (Best)' : '★ Excellent Move';
        badge.className = 'text-[11px] text-[#cceb0d] mt-0.5 font-bold';
        coachText.textContent = currentLang === 'ar'
          ? `نقلة دقيقة (${moveObj.san})! حافظت على توازنك أو عززت نشاط قطعك.`
          : `Accurate move (${moveObj.san})! You maintained control and piece activity.`;
      } else if (diff <= 90) {
        acc = 82;
        badge.textContent = currentLang === 'ar' ? '✓ نقلة جيدة' : '✓ Good Move';
        badge.className = 'text-[11px] text-emerald-400 mt-0.5';
      } else if (diff <= 200) {
        acc = 55;
        badge.textContent = currentLang === 'ar' ? '?! عدم دقة (Inaccuracy)' : '?! Inaccuracy';
        badge.className = 'text-[11px] text-amber-400 mt-0.5 font-semibold';
        coachText.textContent = currentLang === 'ar'
          ? `النقلة (${moveObj.san}) سمحت للخصم بفرصة مضادة. راقب الأسهم الخضراء لاكتشاف البدائل الأقوى.`
          : `The move (${moveObj.san}) gave your opponent counterplay. Check the vision arrows for stronger options.`;
      } else {
        acc = 20;
        badge.textContent = currentLang === 'ar' ? '?? خطأ فادح (Blunder)' : '?? Blunder';
        badge.className = 'text-[11px] text-rose-400 mt-0.5 font-bold';
        coachText.textContent = currentLang === 'ar'
          ? `انتبه! النقلة (${moveObj.san}) أفقدتك أفضلية مادية أو تكتيكية كبيرة. يمكنك التراجع وتجربة نقلة أخرى.`
          : `Watch out! (${moveObj.san}) lost significant material or tactical advantage. Use Undo to retry.`;
      }

      moveAccuracies.push(acc);
      const avgAcc = Math.round(moveAccuracies.reduce((a, b) => a + b, 0) / moveAccuracies.length);
      document.getElementById('accuracy-badge').textContent = currentLang === 'ar' ? `الدقة: ${avgAcc}%` : `Accuracy: ${avgAcc}%`;
    }

    function formatScore(cp) {
      if (Math.abs(cp) >= 90000) {
        return cp > 0 ? '+M' : '-M';
      }
      const pawns = (cp / 100).toFixed(2);
      return cp > 0 ? `+${pawns}` : `${pawns}`;
    }

    function updateEvalBar(scoreCp) {
      const formatted = formatScore(scoreCp);
      document.getElementById('engine-eval-text').textContent = formatted;

      const statusEl = document.getElementById('engine-status-text');
      if (Math.abs(scoreCp) >= 90000) {
        statusEl.textContent = currentLang === 'ar' ? 'كش مات إجباري' : 'Forced Checkmate';
      } else if (scoreCp > 120) {
        statusEl.textContent = currentLang === 'ar' ? 'أفضلية واضحة للأبيض' : 'Clear White Advantage';
      } else if (scoreCp > 30) {
        statusEl.textContent = currentLang === 'ar' ? 'أفضلية طفيفة للأبيض' : 'Slight White Edge';
      } else if (scoreCp < -120) {
        statusEl.textContent = currentLang === 'ar' ? 'أفضلية واضحة للأسود' : 'Clear Black Advantage';
      } else if (scoreCp < -30) {
        statusEl.textContent = currentLang === 'ar' ? 'أفضلية طفيفة للأسود' : 'Slight Black Edge';
      } else {
        statusEl.textContent = currentLang === 'ar' ? 'موقف متعادل' : 'Equal Position';
      }

      // تحويل التقييم إلى نسبة مئوية بين 5% و 95%
      const clamped = Math.max(-1000, Math.min(1000, scoreCp));
      const whitePercent = Math.round(50 + (clamped / 1000) * 45);
      const blackPercent = 100 - whitePercent;

      document.getElementById('white-region');
      document.getElementById('eval-white-region').style.height = `${whitePercent}%`;
      document.getElementById('eval-black-region').style.height = `${blackPercent}%`;

      document.getElementById('eval-score-bottom').textContent = scoreCp >= 0 ? formatted : '';
      document.getElementById('eval-score-top').textContent = scoreCp < 0 ? formatted : '';
    }

    function drawVisionArrows(lines) {
      const svg = document.getElementById('vision-overlay');
      svg.innerHTML = '';

      if (!showVisionArrows || !lines || lines.length === 0 || game.game_over()) return;

      // تعريف رؤوس الأسهم
      svg.innerHTML = `
        <defs>
          <marker id="arrow-primary" markerWidth="4" markerHeight="4" refX="2.5" refY="2" orient="auto">
            <path d="M0,0 L4,2 L0,4 Z" fill="#cceb0d" />
          </marker>
          <marker id="arrow-secondary" markerWidth="4" markerHeight="4" refX="2.5" refY="2" orient="auto">
            <path d="M0,0 L4,2 L0,4 Z" fill="#38bdf8" />
          </marker>
        </defs>
      `;

      lines.slice(0, 2).forEach((line, idx) => {
        const fromCoords = squareToSvgCenter(line.move.from);
        const toCoords = squareToSvgCenter(line.move.to);
        const isPrimary = idx === 0;

        // تقصير السهم قليلاً عند الرأس لوضوح بصري أفضل
        const dx = toCoords.x - fromCoords.x;
        const dy = toCoords.y - fromCoords.y;
        const len = Math.hypot(dx, dy);
        const shorten = 22;
        const endX = toCoords.x - (dx / len) * shorten;
        const endY = toCoords.y - (dy / len) * shorten;

        const lineEl = document.createElementNS('http://www.w3.org/2000/svg', 'line');
        lineEl.setAttribute('x1', fromCoords.x);
        lineEl.setAttribute('y1', fromCoords.y);
        lineEl.setAttribute('x2', endX);
        lineEl.setAttribute('y2', endY);
        lineEl.setAttribute('stroke', isPrimary ? 'rgba(204, 235, 13, 0.88)' : 'rgba(56, 189, 248, 0.52)');
        lineEl.setAttribute('stroke-width', isPrimary ? '16' : '10');
        lineEl.setAttribute('stroke-linecap', 'round');
        lineEl.setAttribute('marker-end', isPrimary ? 'url(#arrow-primary)' : 'url(#arrow-secondary)');
        svg.appendChild(lineEl);
      });
    }

    function squareToSvgCenter(sq) {
      const fileIdx = FILES.indexOf(sq[0]);
      const rankIdx = RANKS.indexOf(sq[1]);
      const col = boardOrientation === 'w' ? fileIdx : 7 - fileIdx;
      const row = boardOrientation === 'w' ? rankIdx : 7 - rankIdx;
      return {
        x: col * 100 + 50,
        y: row * 100 + 50
      };
    }

    /*************************************************************************
     * 7. تحديث سجل النقلات، القطع المأسورة، و PGN/FEN
     *************************************************************************/
    function updateGameMetadataUI() {
      // تحديث مؤشر الدور وحالة المباراة
      const turnBadge = document.getElementById('turn-indicator');
      if (game.in_checkmate()) {
        turnBadge.textContent = i18n[currentLang].checkmate;
        turnBadge.className = 'px-3 py-1 rounded-full text-xs font-bold bg-rose-600 text-white shadow';
      } else if (game.in_draw()) {
        turnBadge.textContent = i18n[currentLang].draw;
        turnBadge.className = 'px-3 py-1 rounded-full text-xs font-bold bg-amber-500 text-slate-950 shadow';
      } else if (game.turn() === 'w') {
        turnBadge.textContent = i18n[currentLang].whiteTurn;
        turnBadge.className = 'px-3 py-1 rounded-full text-xs font-bold bg-white text-slate-950 shadow';
      } else {
        turnBadge.textContent = i18n[currentLang].blackTurn;
        turnBadge.className = 'px-3 py-1 rounded-full text-xs font-bold bg-slate-800 text-white border border-slate-600 shadow';
      }

      // تحديث حقول FEN و PGN
      document.getElementById('fen-input').value = game.fen();
      document.getElementById('pgn-textarea').value = game.pgn();

      // تحديث سجل النقلات
      const history = game.history();
      document.getElementById('move-count-badge').textContent = currentLang === 'ar' ? `${history.length} نقلات` : `${history.length} moves`;

      const listEl = document.getElementById('move-history-list');
      if (history.length === 0) {
        listEl.innerHTML = `<div class="text-slate-500 text-center py-10">${i18n[currentLang].noMovesYet}</div>`;
      } else {
        listEl.innerHTML = '';
        for (let i = 0; i < history.length; i += 2) {
          const moveNum = Math.floor(i / 2) + 1;
          const wMove = history[i] || '';
          const bMove = history[i + 1] || '';
          const row = document.createElement('div');
          row.className = 'grid grid-cols-12 items-center px-2.5 py-1 rounded-lg bg-slate-900/70 hover:bg-slate-800/80';
          row.innerHTML = `
            <span class="col-span-2 text-slate-500">${moveNum}.</span>
            <span class="col-span-5 font-bold text-slate-100">${wMove}</span>
            <span class="col-span-5 font-bold text-[#cceb0d]">${bMove}</span>
          `;
          listEl.appendChild(row);
        }
        listEl.scrollTop = listEl.scrollHeight;
      }

      // اكتشاف اسم الافتتاحية
      const joinedMoves = history.join(' ');
      let detectedOpening = currentLang === 'ar' ? 'وضعية حرة / منتصف اللعب' : 'Custom / Middlegame Position';
      for (const op of OPENINGS_DB) {
        if (joinedMoves.startsWith(op.moves)) {
          detectedOpening = currentLang === 'ar' ? op.ar : op.en;
          break;
        }
      }
      document.getElementById('opening-name').textContent = (currentLang === 'ar' ? 'الافتتاحية: ' : 'Opening: ') + detectedOpening;

      // حساب الفارق المادي والقطع المأسورة
      updateCapturedAndMaterial();
    }

    function updateCapturedAndMaterial() {
      const initial = { p: 8, n: 2, b: 2, r: 2, q: 1 };
      const current = { w: { p: 0, n: 0, b: 0, r: 0, q: 0 }, b: { p: 0, n: 0, b: 0, r: 0, q: 0 } };
      const board = game.board();

      for (let r = 0; r < 8; r++) {
        for (let c = 0; c < 8; c++) {
          const p = board[r][c];
          if (p && p.type !== 'k') {
            current[p.color][p.type]++;
          }
        }
      }

      const symbols = { p: '♟', n: '♞', b: '♝', r: '♜', q: '♛' };
      let whiteScore = 0;
      let blackScore = 0;
      let whiteCapturedHtml = ''; // القطع السوداء التي أسرها الأبيض
      let blackCapturedHtml = ''; // القطع البيضاء التي أسرها الأسود

      ['q', 'r', 'b', 'n', 'p'].forEach(t => {
        whiteScore += current.w[t] * (PIECE_VALUES[t] / 100);
        blackScore += current.b[t] * (PIECE_VALUES[t] / 100);

        const missingBlack = Math.max(0, initial[t] - current.b[t]);
        const missingWhite = Math.max(0, initial[t] - current.w[t]);
        whiteCapturedHtml += symbols[t].repeat(missingBlack);
        blackCapturedHtml += symbols[t].repeat(missingWhite);
      });

      document.getElementById('bottom-captured').textContent = boardOrientation === 'w' ? whiteCapturedHtml : blackCapturedHtml;
      document.getElementById('top-captured').textContent = boardOrientation === 'w' ? blackCapturedHtml : whiteCapturedHtml;

      const diff = whiteScore - blackScore;
      const diffText = diff > 0 ? `+${diff}` : `${diff}`;
      document.getElementById('material-diff-badge').textContent =
        (currentLang === 'ar' ? 'التوازن المادي: ' : 'Material: ') + diffText;
    }

    /*************************************************************************
     * 8. أزرار التحكم، الألغاز، والاستيراد/التصدير
     *************************************************************************/
    function resetGame() {
      game.reset();
      selectedSquare = null;
      legalTargets = [];
      moveAccuracies = [];
      lastEvalBeforeMove = 25;
      currentPuzzle = null;
      renderBoard();
      analyzeCurrentPosition();
      showToast(currentLang === 'ar' ? 'تم بدء مباراة جديدة' : 'New game started');
    }

    function flipBoard() {
      boardOrientation = boardOrientation === 'w' ? 'b' : 'w';
      const topName = document.getElementById('top-player-name');
      const bottomName = document.getElementById('bottom-player-name');
      const topBadge = document.getElementById('top-player-badge');
      const bottomBadge = document.getElementById('bottom-player-badge');

      if (boardOrientation === 'w') {
        topName.textContent = i18n[currentLang].engineName;
        bottomName.textContent = i18n[currentLang].playerYou;
        topBadge.textContent = '♚';
        topBadge.className = 'w-8 h-8 rounded-lg bg-slate-800 border border-slate-700 flex items-center justify-center text-sm font-bold';
        bottomBadge.textContent = '♔';
        bottomBadge.className = 'w-8 h-8 rounded-lg bg-slate-100 text-slate-950 flex items-center justify-center text-sm font-bold';
      } else {
        topName.textContent = i18n[currentLang].playerYou;
        bottomName.textContent = i18n[currentLang].engineName;
        topBadge.textContent = '♔';
        topBadge.className = 'w-8 h-8 rounded-lg bg-slate-100 text-slate-950 flex items-center justify-center text-sm font-bold';
        bottomBadge.textContent = '♚';
        bottomBadge.className = 'w-8 h-8 rounded-lg bg-slate-800 border border-slate-700 flex items-center justify-center text-sm font-bold';
      }

      renderBoard();
      analyzeCurrentPosition();
    }

    function undoMove() {
      const undone = game.undo();
      if (!undone) return;
      if (appMode === 'ai') {
        game.undo();
      }
      selectedSquare = null;
      legalTargets = [];
      renderBoard();
      analyzeCurrentPosition();
    }

    function toggleVisionArrows() {
      showVisionArrows = !showVisionArrows;
      const btn = document.getElementById('btn-toggle-arrows');
      if (showVisionArrows) {
        btn.className = 'p-2.5 rounded-xl bg-[#cceb0d]/15 hover:bg-[#cceb0d]/25 border border-[#cceb0d]/40 text-[#cceb0d] text-xs font-semibold flex items-center justify-center gap-1.5 transition';
      } else {
        btn.className = 'p-2.5 rounded-xl bg-[#161922] hover:bg-slate-800 border border-slate-800 text-slate-400 text-xs font-semibold flex items-center justify-center gap-1.5 transition';
      }
      analyzeCurrentPosition();
    }

    function playEngineBestMove() {
      if (game.game_over()) return;
      if (!currentBestMove) {
        analyzeCurrentPosition();
      }
      if (currentBestMove) {
        game.move(currentBestMove);
        selectedSquare = null;
        legalTargets = [];
        renderBoard();
        analyzeCurrentPosition();
      }
    }

    function loadNextPuzzle() {
      setAppMode('puzzle');
      switchTab('trainer');
      const randomIndex = Math.floor(Math.random() * TACTICAL_PUZZLES.length);
      currentPuzzle = TACTICAL_PUZZLES[randomIndex];

      game.load(currentPuzzle.fen);
      boardOrientation = game.turn();
      selectedSquare = null;
      legalTargets = [];

      document.getElementById('puzzle-rating').textContent = currentPuzzle.rating;
      document.getElementById('puzzle-description').textContent = currentLang === 'ar' ? currentPuzzle.ar : currentPuzzle.en;

      renderBoard();
      analyzeCurrentPosition();
      showToast(currentLang === 'ar' ? 'تم تحميل لغز تكتيكي جديد!' : 'New tactical puzzle loaded!', 'success');
    }

    function showPuzzleHint() {
      if (!currentPuzzle) {
        loadNextPuzzle();
        return;
      }
      const fromSq = currentPuzzle.solutionUci.slice(0, 2);
      selectedSquare = fromSq;
      legalTargets = game.moves({ square: fromSq, verbose: true }).map(m => m.to);
      renderBoard();
      showToast(currentLang === 'ar' ? `تلميح: حرك القطعة الموجودة في المربع ${fromSq}` : `Hint: Move the piece on square ${fromSq}`, 'info');
    }

    function setAppMode(mode) {
      appMode = mode;
      const btns = {
        analysis: document.getElementById('mode-analysis-btn'),
        ai: document.getElementById('mode-vs-ai-btn'),
        puzzle: document.getElementById('mode-puzzle-btn')
      };

      Object.entries(btns).forEach(([key, btn]) => {
        if (key === mode) {
          btn.className = 'px-3 py-1.5 rounded-lg bg-[#cceb0d] text-slate-950 font-bold transition';
        } else {
          btn.className = 'px-3 py-1.5 rounded-lg text-slate-300 hover:text-white transition';
        }
      });
    }

    function switchTab(tabName) {
      ['moves', 'trainer', 'io'].forEach(t => {
        const panel = document.getElementById(`tab-panel-${t}`);
        const btn = document.getElementById(`tab-btn-${t}`);
        if (t === tabName) {
          panel.classList.remove('hidden');
          btn.className = 'flex-1 py-3 text-center border-b-2 border-[#cceb0d] text-[#cceb0d] transition';
        } else {
          panel.classList.add('hidden');
          btn.className = 'flex-1 py-3 text-center border-b-2 border-transparent text-slate-400 hover:text-white transition';
        }
      });
    }

    function importFEN() {
      const fenStr = document.getElementById('fen-input').value.trim();
      const loaded = game.load(fenStr);
      if (!loaded) {
        showToast(currentLang === 'ar' ? 'صيغة FEN غير صالحة!' : 'Invalid FEN string!', 'warn');
        return;
      }
      selectedSquare = null;
      legalTargets = [];
      renderBoard();
      analyzeCurrentPosition();
      showToast(currentLang === 'ar' ? 'تم تحميل وضعية FEN بنجاح' : 'FEN position loaded successfully', 'success');
    }

    function importPGN() {
      const pgnStr = document.getElementById('pgn-textarea').value.trim();
      if (!pgnStr) return;
      const loaded = game.load_pgn(pgnStr);
      if (!loaded) {
        showToast(currentLang === 'ar' ? 'تعذر قراءة نص PGN، تأكد من صحة النقلات' : 'Invalid PGN format', 'warn');
        return;
      }
      selectedSquare = null;
      legalTargets = [];
      renderBoard();
      analyzeCurrentPosition();
      switchTab('moves');
      showToast(currentLang === 'ar' ? 'تم استيراد المباراة بنجاح' : 'PGN game imported successfully', 'success');
    }

    function exportPGNFile() {
      const pgnContent = game.pgn() || '[Event "Chess-Vision Stockfish UCI Analysis"]\n\n*';
      const blob = new Blob([pgnContent], { type: 'text/plain;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'chess-vision-analysis.pgn';
      a.click();
      URL.revokeObjectURL(url);
      showToast(currentLang === 'ar' ? 'تم تنزيل ملف PGN' : 'PGN file downloaded', 'success');
    }

    function copyText(elementId) {
      const el = document.getElementById(elementId);
      el.select();
      document.execCommand('copy');
      showToast(currentLang === 'ar' ? 'تم النسخ إلى الحافظة' : 'Copied to clipboard', 'success');
    }

    function toggleLanguage() {
      currentLang = currentLang === 'ar' ? 'en' : 'ar';
      const htmlEl = document.documentElement;
      htmlEl.lang = currentLang;
      htmlEl.dir = currentLang === 'ar' ? 'rtl' : 'ltr';

      document.getElementById('lang-toggle-btn').textContent = currentLang === 'ar' ? 'EN' : 'عربي';
      document.getElementById('subtitle-text').textContent = i18n[currentLang].subtitle;
      document.getElementById('mode-analysis-btn').textContent = i18n[currentLang].analysisMode;
      document.getElementById('mode-vs-ai-btn').textContent = i18n[currentLang].aiMode;
      document.getElementById('mode-puzzle-btn').textContent = i18n[currentLang].puzzleMode;

      document.querySelectorAll('[data-i18n]').forEach(el => {
        const key = el.getAttribute('data-i18n');
        if (i18n[currentLang][key]) {
          el.textContent = i18n[currentLang][key];
        }
      });

      renderBoard();
      analyzeCurrentPosition();
    }

    // التشغيل الأولي عند تحميل الصفحة
    window.addEventListener('DOMContentLoaded', () => {
      renderBoard();
      analyzeCurrentPosition();
    });
  </script>
</body>
</html>