<!DOCTYPE html>
<html lang="ar" dir="rtl" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Chess-Vision Stockfish UCI | استوديو تحليل وتدريب الشطرنج</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- مكتبة chess.js لإدارة قواعد الشطرنج الكاملة والتحقق من النقلات وPGN/FEN -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/chess.js/0.10.3/chess.min.js"></script>
  <!-- خطوط عربية وإنجليزية عصرية -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />

  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Cairo', 'Inter', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace'],
          },
          colors: {
            brand: {
              lime: '#cceb0d',
              gold: '#e5da23',
              dark: '#0f1115',
              card: '#171a21',
              border: '#262b36'
            }
          }
        }
      }
    };
  </script>

  <style>
    /* تخصيصات بصرية للوحة الشطرنج والتأثيرات */
    body {
      font-family: 'Cairo', 'Inter', sans-serif;
      background-color: #0d0f13;
      color: #f1f5f9;
      overflow-x: hidden;
    }

    html[dir="ltr"] body {
      font-family: 'Inter', 'Cairo', sans-serif;
    }

    /* ألوان مربعات الرقعة الاحترافية */
    .sq-light {
      background-color: #ebecd0;
      color: #739552;
    }
    .sq-dark {
      background-color: #739552;
      color: #ebecd0;
    }

    /* تمييز المربعات المختارة وآخر نقلة والكش */
    .sq-selected {
      background-color: rgba(204, 235, 13, 0.72) !important;
    }
    .sq-last-move {
      background-color: rgba(229, 218, 35, 0.48) !important;
    }
    .sq-check {
      background: radial-gradient(circle, rgba(239,68,68,0.95) 0%, rgba(185,28,28,0.65) 65%, transparent 100%) !important;
    }

    /* مؤشرات النقلات القانونية */
    .legal-dot {
      width: 28%;
      height: 28%;
      background-color: rgba(15, 23, 42, 0.28);
      border-radius: 9999px;
      pointer-events: none;
    }
    .legal-ring {
      width: 84%;
      height: 84%;
      border: 4px solid rgba(15, 23, 42, 0.32);
      border-radius: 9999px;
      pointer-events: none;
    }

    /* شريط التقييم العمودي */
    .eval-bar-fill {
      transition: height 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    }

    /* شريط تمرير أنيق */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #14171d;
    }
    ::-webkit-scrollbar-thumb {
      background: #2f3644;
      border-radius: 999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #cceb0d;
    }

    .piece-svg {
      width: 82%;
      height: 82%;
      filter: drop-shadow(0 3px 3px rgba(0, 0, 0, 0.35));
      transition: transform 0.14s ease;
      user-select: none;
      pointer-events: none;
    }
    .square-btn:hover .piece-svg {
      transform: scale(1.06);
    }
  </style>
</head>
<body class="min-h-screen flex flex-col bg-[#0d0f13] text-slate-100 selection:bg-[#cceb0d] selection:text-black">

  <!-- إشعار عائم بديل لـ alert() -->
  <div id="toast-container" class="fixed bottom-4 left-1/2 -translate-x-1/2 z-50 flex flex-col gap-2 pointer-events-none w-[92%] max-w-md"></div>

  <!-- الشريط العلوي -->
  <header class="sticky top-0 z-30 border-b border-slate-800/80 bg-[#12151c]/95 backdrop-blur-md">
    <div class="max-w-7xl mx-auto px-3 sm:px-6 py-3 flex flex-wrap items-center justify-between gap-3">
      <!-- الهوية والشعار -->
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-[#cceb0d] to-[#e5da23] flex items-center justify-center text-slate-950 font-extrabold shadow-lg shadow-[#cceb0d]/20">
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor">
            <path d="M19 22H5v-2h14v2M17.16 8.26A4.96 4.96 0 0 0 18 5.5C18 3 16 1 13.5 1c-1.54 0-2.92.78-3.73 2H7v3l2 1-2 4.5V14h3.5l-1 4h7l-1.5-5.5 2.16-4.24Z"/>
          </svg>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h1 class="text-base sm:text-lg font-extrabold tracking-tight text-white">Chess-Vision Stockfish UCI</h1>
            <span class="hidden sm:inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-mono font-semibold bg-[#cceb0d]/15 text-[#cceb0d] border border-[#cceb0d]/30">
              UCI ENGINE v17
            </span>
          </div>
          <p id="subtitle-text" class="text-xs text-slate-400">مختبر التحليل التكتيكي وتدريب الرؤية الشطرنجية</p>
        </div>
      </div>

      <!-- أزرار التحكم بالوضع واللغة -->
      <div class="flex items-center gap-2">
        <!-- تبديل وضع اللعب / التدريب -->
        <div class="flex rounded-xl bg-slate-900 p-1 border border-slate-800 text-xs font-semibold">
          <button id="mode-analysis-btn" onclick="setAppMode('analysis')" class="px-3 py-1.5 rounded-lg bg-[#cceb0d] text-slate-950 transition">
            تحليل حر
          </button>
          <button id="mode-vs-ai-btn" onclick="setAppMode('ai')" class="px-3 py-1.5 rounded-lg text-slate-300 hover:text-white transition">
            تحدي المحرك
          </button>
          <button id="mode-puzzle-btn" onclick="setAppMode('puzzle')" class="px-3 py-1.5 rounded-lg text-slate-300 hover:text-white transition">
            تدريب تكتيكي
          </button>
        </div>

        <!-- زر تبديل اللغة -->
        <button id="lang-toggle-btn" onclick="toggleLanguage()" class="px-3 py-2 rounded-xl bg-slate-800/90 hover:bg-slate-700 border border-slate-700 text-xs font-bold text-[#e5da23] transition">
          EN
        </button>
      </div>
    </div>
  </header>

  <!-- المحتوى الرئيسي -->
  <main class="flex-1 max-w-7xl w-full mx-auto px-3 sm:px-6 py-4 sm:py-6 grid grid-cols-1 lg:grid-cols-12 gap-5 items-start">

    <!-- العمود الأيمن/الأيسر: الرقعة وشريط التقييم -->
    <section class="lg:col-span-7 flex flex-col gap-3">
      <!-- شريط معلومات الخصم / المحرك العلوي -->
      <div class="flex items-center justify-between bg-[#161922] border border-slate-800 rounded-2xl px-4 py-2.5">
        <div class="flex items-center gap-2.5">
          <div id="top-player-badge" class="w-8 h-8 rounded-lg bg-slate-800 border border-slate-700 flex items-center justify-center text-sm font-bold">
            ♚
          </div>
          <div>
            <div id="top-player-name" class="text-sm font-bold text-slate-100">Stockfish UCI Neural</div>
            <div id="top-captured" class="text-xs text-slate-400 h-4 flex items-center gap-1"></div>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <span id="turn-indicator" class="px-3 py-1 rounded-full text-xs font-bold bg-white text-slate-950 shadow">
            دور الأبيض
          </span>
        </div>
      </div>

      <!-- حاوية الرقعة + شريط التقييم العمودي -->
      <div class="flex items-stretch gap-2.5 sm:gap-3 justify-center">
        <!-- شريط التقييم (Evaluation Bar) -->
        <div class="w-7 sm:w-8 rounded-xl bg-slate-950 border border-slate-800 overflow-hidden flex flex-col justify-between relative select-none shadow-inner" title="تقييم الموقف">
          <!-- الجزء الأسود في الأعلى -->
          <div id="eval-black-region" class="w-full bg-[#1e222d] flex items-start justify-center pt-1.5 transition-all duration-500" style="height: 50%;">
            <span id="eval-score-top" class="text-[10px] font-mono font-bold text-slate-300">0.0</span>
          </div>
          <!-- الجزء الأبيض في الأسفل -->
          <div id="eval-white-region" class="w-full bg-[#f1f5f9] flex items-end justify-center pb-1.5 transition-all duration-500" style="height: 50%;">
            <span id="eval-score-bottom" class="text-[10px] font-mono font-bold text-slate-950">0.0</span>
          </div>
        </div>

        <!-- رقعة الشطرنج التفاعلية + طبقة أسهم الرؤية (Chess-Vision SVG Overlay) -->
        <div class="relative w-full max-w-[560px] aspect-square rounded-2xl overflow-hidden shadow-2xl border-2 border-slate-800 bg-slate-900">
          <div id="chess-board" class="grid grid-cols-8 grid-rows-8 w-full h-full"></div>
          <!-- طبقة الأسهم البصرية لأفضل نقلة والتهديدات -->
          <svg id="vision-overlay" viewBox="0 0 800 800" class="absolute inset-0 w-full h-full pointer-events-none z-10"></svg>
        </div>
      </div>

      <!-- شريط معلومات اللاعب السفلي -->
      <div class="flex items-center justify-between bg-[#161922] border border-slate-800 rounded-2xl px-4 py-2.5">
        <div class="flex items-center gap-2.5">
          <div id="bottom-player-badge" class="w-8 h-8 rounded-lg bg-slate-100 text-slate-950 flex items-center justify-center text-sm font-bold">
            ♔
          </div>
          <div>
            <div id="bottom-player-name" class="text-sm font-bold text-slate-100">اللاعب (أنت)</div>
            <div id="bottom-captured" class="text-xs text-slate-400 h-4 flex items-center gap-1"></div>
          </div>
        </div>
        <div id="material-diff-badge" class="text-xs font-mono px-2.5 py-1 rounded-lg bg-slate-800 text-slate-300">
          التوازن المادي: 0
        </div>
      </div>

      <!-- شريط أدوات التحكم السريع بالرقعة -->
      <div class="grid grid-cols-3 sm:grid-cols-6 gap-2">
        <button onclick="resetGame()" class="p-2.5 rounded-xl bg-[#161922] hover:bg-slate-800 border border-slate-800 text-xs font-semibold flex items-center justify-center gap-1.5 transition" title="مباراة جديدة">
          <span>🔄</span> <span data-i18n="newGame">جديد</span>
        </button>
        <button onclick="flipBoard()" class="p-2.5 rounded-xl bg-[#161922] hover:bg-slate-800 border border-slate-800 text-xs font-semibold flex items-center justify-center gap-1.5 transition" title="قلب الرقعة">
          <span>⇅</span> <span data-i18n="flip">قلب</span>
        </button>
        <button onclick="undoMove()" class="p-2.5 rounded-xl bg-[#161922] hover:bg-slate-800 border border-slate-800 text-xs font-semibold flex items-center justify-center gap-1.5 transition" title="تراجع">
          <span>↩️</span> <span data-i18n="undo">تراجع</span>
        </button>
        <button onclick="toggleVisionArrows()" id="btn-toggle-arrows" class="p-2.5 rounded-xl bg-[#cceb0d]/15 hover:bg-[#cceb0d]/25 border border-[#cceb0d]/40 text-[#cceb0d] text-xs font-semibold flex items-center justify-center gap-1.5 transition" title="أسهم الرؤية">
          <span>👁️</span> <span data-i18n="vision">الرؤية</span>
        </button>
        <button onclick="playEngineBestMove()" class="p-2.5 rounded-xl bg-[#161922] hover:bg-slate-800 border border-slate-800 text-xs font-semibold flex items-center justify-center gap-1.5 transition text-[#e5da23]" title="تنفيذ أفضل نقلة">
          <span>⚡</span> <span data-i18n="playBest">نفّذ الأفضل</span>
        </button>
        <button onclick="loadNextPuzzle()" class="p-2.5 rounded-xl bg-[#161922] hover:bg-slate-800 border border-slate-800 text-xs font-semibold flex items-center justify-center gap-1.5 transition text-emerald-400" title="لغز تدريبي">
          <span>🎯</span> <span data-i18n="puzzle">لغز</span>
        </button>
      </div>
    </section>

    <!-- العمود الثاني: لوحة محرك التحليل UCI، سجل النقلات، و PGN/FEN -->
    <section class="lg:col-span-5 flex flex-col gap-4">

      <!-- بطاقة محرك Stockfish UCI -->
      <div class="bg-[#161922] border border-slate-800 rounded-2xl p-4 shadow-xl">
        <div class="flex items-center justify-between mb-3">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-[#cceb0d] animate-pulse"></span>
            <h2 class="text-sm font-extrabold text-white" data-i18n="engineTitle">تحليل المحرك (Stockfish UCI)</h2>
          </div>
          <div class="flex items-center gap-2">
            <label for="depth-select" class="text-xs text-slate-400" data-i18n="depth">العمق:</label>
            <select id="depth-select" onchange="analyzeCurrentPosition()" class="bg-slate-900 border border-slate-700 rounded-lg px-2 py-1 text-xs font-mono text-[#cceb0d] focus:outline-none">
              <option value="1">Depth 1 (سريع)</option>
              <option value="2" selected>Depth 2 (متوازن)</option>
              <option value="3">Depth 3 (عميق)</option>
            </select>
          </div>
        </div>

        <!-- بطاقة أفضل نقلة وتقييم الموقف -->
        <div class="grid grid-cols-2 gap-2.5 mb-3">
          <div class="bg-slate-900/90 border border-slate-800 rounded-xl p-3">
            <div class="text-[11px] text-slate-400 mb-0.5" data-i18n="evalLabel">تقييم الموقف</div>
            <div id="engine-eval-text" class="text-xl font-mono font-extrabold text-[#cceb0d]">+0.25</div>
            <div id="engine-status-text" class="text-[11px] text-slate-400 mt-0.5">أفضلية طفيفة للأبيض</div>
          </div>
          <div class="bg-slate-900/90 border border-slate-800 rounded-xl p-3">
            <div class="text-[11px] text-slate-400 mb-0.5" data-i18n="bestMoveLabel">أفضل نقلة (UCI / SAN)</div>
            <div class="flex items-baseline gap-2">
              <span id="engine-best-san" class="text-xl font-mono font-extrabold text-white">e4</span>
              <span id="engine-best-uci" class="text-xs font-mono text-[#e5da23]">(e2e4)</span>
            </div>
            <div id="move-quality-badge" class="text-[11px] text-emerald-400 mt-0.5">جاهز للتحليل</div>
          </div>
        </div>

        <!-- خطوط التفريع المقترحة (Principal Variations) -->
        <div class="bg-slate-950/70 border border-slate-800/80 rounded-xl p-2.5">
          <div class="text-[11px] font-semibold text-slate-400 mb-1.5 flex justify-between">
            <span data-i18n="topLines">أفضل التفريعات المقترحة (MultiPV):</span>
            <span id="nodes-counter" class="font-mono text-slate-500">0 nodes</span>
          </div>
          <div id="pv-lines-container" class="flex flex-col gap-1.5 text-xs font-mono">
            <!-- يتم ملؤها ديناميكياً -->
          </div>
        </div>
      </div>

      <!-- بطاقة التبويبات: سجل النقلات / التدريب / PGN & FEN -->
      <div class="bg-[#161922] border border-slate-800 rounded-2xl overflow-hidden shadow-xl flex flex-col">
        <div class="flex border-b border-slate-800 bg-slate-900/60 text-xs font-bold">
          <button onclick="switchTab('moves')" id="tab-btn-moves" class="flex-1 py-3 text-center border-b-2 border-[#cceb0d] text-[#cceb0d] transition" data-i18n="tabMoves">
            سجل النقلات
          </button>
          <button onclick="switchTab('trainer')" id="tab-btn-trainer" class="flex-1 py-3 text-center border-b-2 border-transparent text-slate-400 hover:text-white transition" data-i18n="tabTrainer">
            المدرب الذكي
          </button>
          <button onclick="switchTab('io')" id="tab-btn-io" class="flex-1 py-3 text-center border-b-2 border-transparent text-slate-400 hover:text-white transition">
            PGN / FEN
          </button>
        </div>

        <!-- محتوى تبويب 1: سجل النقلات -->
        <div id="tab-panel-moves" class="p-3.5">
          <div class="flex items-center justify-between mb-2">
            <span id="opening-name" class="text-xs font-semibold text-[#e5da23] truncate">الافتتاحية: وضعية البداية القياسية</span>
            <span id="move-count-badge" class="text-[11px] font-mono text-slate-400">0 نقلات</span>
          </div>
          <div id="move-history-list" class="h-52 overflow-y-auto bg-slate-950/70 border border-slate-800 rounded-xl p-2 space-y-1 text-xs font-mono">
            <div class="text-slate-500 text-center py-10" data-i18n="noMovesYet">ابدأ بتحريك القطع على الرقعة لعرض التحليل...</div>
          </div>
        </div>

        <!-- محتوى تبويب 2: المدرب الذكي والألغاز -->
        <div id="tab-panel-trainer" class="p-4 hidden space-y-3">
          <div class="bg-slate-900/90 border border-slate-800 rounded-xl p-3">
            <div class="flex items-center justify-between mb-1">
              <span class="text-xs font-bold text-[#cceb0d]" data-i18n="coachFeedback">ملاحظات المدرب الفورية</span>
              <span id="accuracy-badge" class="text-xs font-mono px-2 py-0.5 rounded bg-emerald-500/15 text-emerald-400">الدقة: 100%</span>
            </div>
            <p id="coach-advice-text" class="text-xs text-slate-300 leading-relaxed">
              حاول السيطرة على مربعات الوسط (e4, d4, e5, d5) وتطوير القطع الخفيفة مبكراً قبل تحريك الوزير.
            </p>
          </div>

          <div class="bg-slate-900/90 border border-slate-800 rounded-xl p-3 space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-white" data-i18n="tacticalChallenge">التحدي التكتيكي الحالي</span>
              <span id="puzzle-rating" class="text-[11px] font-mono text-[#e5da23]">1450 ELO</span>
            </div>
            <p id="puzzle-description" class="text-xs text-slate-400">
              اضغط على زر "لغز" لتحميل موقف تكتيكي حقيقي واختبار قدرتك على إيجاد النقلة الحاسمة.
            </p>
            <div class="flex gap-2 pt-1">
              <button onclick="loadNextPuzzle()" class="flex-1 py-2 px-3 rounded-xl bg-[#cceb0d] text-slate-950 font-bold text-xs hover:brightness-105 transition" data-i18n="loadPuzzleBtn">
                تحميل لغز جديد
              </button>
              <button onclick="showPuzzleHint()" class="py-2 px-3 rounded-xl bg-slate-800 text-slate-200 font-semibold text-xs hover:bg-slate-700 transition" data-i18n="hintBtn">
                تلميح
              </button>
            </div>
          </div>
        </div>

        <!-- محتوى تبويب 3: استيراد وتصدير PGN / FEN -->
        <div id="tab-panel-io" class="p-4 hidden space-y-3">
          <!-- قسم FEN -->
          <div>
            <div class="flex items-center justify-between mb-1">
              <label class="text-xs font-bold text-slate-300">وضعية الرقعة (FEN)</label>
              <button onclick="copyText('fen-input')" class="text-[11px] text-[#cceb0d] hover:underline" data-i18n="copy">نسخ</button>
            </div>
            <div class="flex gap-2">
              <input id="fen-input" type="text" dir="ltr" class="flex-1 bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs font-mono text-slate-200 focus:border-[#cceb0d] focus:outline-none" />
              <button onclick="importFEN()" class="px-3 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-xs font-bold text-white transition" data-i18n="load">تحميل</button>
            </div>
          </div>

          <!-- قسم PGN -->
          <div>
            <div class="flex items-center justify-between mb-1">
              <label class="text-xs font-bold text-slate-300">سجل المباراة (PGN)</label>
              <button onclick="copyText('pgn-textarea')" class="text-[11px] text-[#cceb0d] hover:underline" data-i18n="copy">نسخ</button>
            </div>
            <textarea id="pgn-textarea" rows="4" dir="ltr" placeholder="1. e4 e5 2. Nf3 Nc6 3. Bb5..." class="w-full bg-slate-950 border border-slate-800 rounded-xl p-2.5 text-xs font-mono text-slate-200 focus:border-[#cceb0d] focus:outline-none"></textarea>
            <div class="flex gap-2 mt-2">
              <button onclick="importPGN()" class="flex-1 py-2 rounded-xl bg-[#cceb0d] text-slate-950 font-bold text-xs hover:brightness-105 transition" data-i18n="importPgn">
                استيراد PGN
              </button>
              <button onclick="exportPGNFile()" class="flex-1 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-white font-bold text-xs transition" data-i18n="downloadPgn">
                تنزيل ملف .pgn
              </button>
            </div>
          </div>
        </div>
      </div>

    </section>
  </main>

  <!-- نافذة ترقية البيدق -->
  <div id="promotion-modal" class="fixed inset-0 z-50 bg-black/75 backdrop-blur-sm hidden items-center justify-center p-4">
    <div class="bg-[#171a21] border border-slate-700 rounded-2xl p-5 max-w-xs w-full text-center shadow-2xl">
      <h3 class="text-sm font-extrabold text-white mb-3" data-i18n="choosePromotion">اختر قطعة الترقية</h3>
